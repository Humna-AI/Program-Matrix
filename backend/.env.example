# Database & Server
DATABASE_URL="file:./app.db"
JWT_SECRET="super-secret-key-12345-change-me-in-production"
PORT=5000

# ====================================================================
# SMTP Email Dispatch Configuration
# Used for Admin Forgot Password 6-Digit Verification Codes
# ====================================================================

# Sender display name and email
EMAIL_FROM="Program Matrix Security <info@jobs-group.org>"

# 1. Custom Domain / cPanel / Webmail (Standard SSL Port 465)
SMTP_HOST=mail.jobs-group.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@jobs-group.org
SMTP_PASS=your_email_account_password_here

# 2. Alternative: STARTTLS (Port 587)
# SMTP_HOST=mail.jobs-group.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=info@jobs-group.org
# SMTP_PASS=your_email_account_password_here

# 3. Alternative: Microsoft 365 / Outlook
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=info@jobs-group.org
# SMTP_PASS=your_app_password_here

# 4. Alternative: Google Workspace / Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@jobs-group.org
# SMTP_PASS=your_google_app_password_here

# ====================================================================
# Initial Administrator Account Seed (Optional)
# ====================================================================
ADMIN_INITIAL_NAME=Shahrukh
ADMIN_INITIAL_EMAIL=Shahrukh@jobs-group.org
ADMIN_INITIAL_PASSWORD=your_initial_admin_password_here
ADMIN_INITIAL_RECOVERY_KEY=ADM-2026-YOUR-KEY-ROOT

