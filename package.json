{
  "name": "software-tracker",
  "version": "1.0.0",
  "description": "Project Tracker with Role-Based Access Control (RBAC)",
  "main": "backend/src/index.js",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "build": "node build.js",
    "start": "node backend/src/index.js",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test:email": "npm run test:email --prefix backend --",
    "admin:recover": "npm run admin:recover --prefix backend --"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
